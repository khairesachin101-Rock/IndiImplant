# Copy this file to ".env" in the same folder (frontend/.env) and fill in
# your own project's values from Supabase → Project Settings → API.
# .env is already git-ignored — never commit your real keys.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
